# ==============================================================================
# Cyber Threat Intelligence Platform - .gitignore
# Covers Frontend (React/Vite), Backend (Python/FastAPI), Environment & OS files
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: Python & FastAPI
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*/venv/
*/.venv/

# Python packaging & distribution
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & local stores
*.sqlite
*.sqlite3
*.db
backend/data/*.sqlite3

# ------------------------------------------------------------------------------
# Frontend: Node.js, Vite & React
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
*/**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
dist/
frontend/dist/
dist-ssr/
*.local

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
backend/.env
frontend/.env
frontend/.env.local

# Allow example configs
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# Editor & IDE artifacts
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# OS-specific files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
